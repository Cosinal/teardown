# Neon Postgres connection string (Vercel's Neon integration sets this automatically).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Admin secret: GET/DELETE on /api/subscribe, and unlocks the gated /new form via /new?key=... (sets a cookie). Use a long random string, e.g. `openssl rand -hex 32`.
ADMIN_KEY=change-me

# Anthropic API key for the teardown engine (Claude + server-side web search). Billable.
# Create it inside a workspace in the Anthropic Console: org-level keys without a workspace are rejected (400).
ANTHROPIC_API_KEY=sk-ant-change-me
