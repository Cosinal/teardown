# Neon Postgres connection string (Vercel's Neon integration sets this automatically).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Admin secret: GET/DELETE on /api/subscribe, and unlocks /new and /admin via ?key=... (sets a cookie). Use a long random string, e.g. `openssl rand -hex 32`.
ADMIN_KEY=change-me

# Anthropic API key for the teardown engine (Claude + server-side web search). Billable.
# Create it inside a workspace in the Anthropic Console: org-level keys without a workspace are rejected (400).
ANTHROPIC_API_KEY=sk-ant-change-me

# Stripe (test mode: sk_test_... keys outside production). The secret key creates Checkout Sessions and refunds.
STRIPE_SECRET_KEY=sk_test_change-me
# Signing secret of the webhook endpoint pointed at /api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_change-me
# The one-time Price a teardown is sold at (price_...).
STRIPE_PRICE_ID=price_change-me
